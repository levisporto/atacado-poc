# Copie para .env e preencha. Sem credenciais TOTVS o app sobe em modo demonstração.

# --- TOTVS Moda (API V2) ---
TOTVS_BASE_URL=https://apitotvsmoda.bhan.com.br
TOTVS_CLIENT_ID=
TOTVS_CLIENT_SECRET=
TOTVS_USERNAME=
TOTVS_PASSWORD=
TOTVS_BRANCH_CODE=1
TOTVS_STOCK_BRANCH_CODES=1,2
TOTVS_STOCK_CODES=1
TOTVS_PRICE_CODE_ATACADO=3
TOTVS_PRICE_CODE_VAREJO=1
TOTVS_SUBTRACT_SALES_ORDERS=true
CATALOG_SYNC_SECONDS=60
CATALOG_FULL_REFRESH_HOURS=6
# MOCK_MODE=true

# --- Regras do atacado ---
MIN_ORDER_VALUE=500
MIN_QTY_PER_REF=6

# --- Destino do pedido ---
GLEICE_WHATSAPP=5585999999999

# Opção A: Evolution API (envio automático pelo número da empresa)
EVOLUTION_URL=
EVOLUTION_INSTANCE=
EVOLUTION_API_KEY=

# Opção B: webhook n8n (recebe JSON + mensagem pronta)
N8N_WEBHOOK_URL=

# Sem A nem B: o comprador recebe um link wa.me já preenchido.

# --- Cadastro de lojistas e painel /admin ---
ADMIN_USERS=admin:troque-esta-senha
# DB_PATH=/var/data/atacado.db
SESSION_DAYS=30
NOTIFY_NEW_SIGNUPS=true
# COOKIE_SECURE=false

ALLOWED_ORIGINS=*
